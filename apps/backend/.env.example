# Atlassian OAuth 2.0 (3LO) app credentials.
ATLASSIAN_CLIENT_ID=your-client-id
ATLASSIAN_CLIENT_SECRET=your-client-secret

# Must exactly match the callback URL registered in the Atlassian developer console.
# This demo redirects to the frontend callback page, which then calls the backend.
# localhost may use HTTP; non-localhost callback URLs must use HTTPS.
ATLASSIAN_REDIRECT_URI=http://localhost:5173/oauth2/callback

# Granular Confluence scope plus offline_access for refresh tokens.
# Do not mix granular scopes with classic scopes.
ATLASSIAN_SCOPES=read:space:confluence offline_access

# Exact browser origin of the frontend. Used for CORS and the post-OAuth redirect.
FRONTEND_URL=https://your-host:5173

# Generate a long random value, for example: openssl rand -hex 32
JWT_SECRET=change-me

# JWT lifetime in minutes.
JWT_EXPIRE_MINUTES=480
